PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mtg_inventory
UPLOAD_DIR=uploads
PYTHON_BIN=python3
SCAN_SCRIPT_PATH=scan.py

# OCR provider. Paddle is local; Azure is retained as an alternate provider.
OCR_PROVIDER=paddle
PADDLE_USE_GPU=false
PADDLE_DEVICE=cpu
PADDLE_OCR_LANG=en
PADDLE_USE_ANGLE_CLS=true

# Required only when OCR_PROVIDER=azure.
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# Docker Compose reads the Azure values from your shell or a local .env file.
