FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg libglib2.0-0 libgl1 libgomp1 libsm6 libxext6 python3 python3-pip \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package.json
RUN npm install --omit=dev

COPY requirements.gpu.txt requirements.gpu.txt
RUN pip3 install --no-cache-dir -r requirements.gpu.txt -i https://www.paddlepaddle.org.cn/packages/stable/cu118/

COPY requirements.txt requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt

COPY server.js scan.py ./

ENV OCR_PROVIDER=paddle
ENV PADDLE_USE_GPU=true
ENV PADDLE_DEVICE=gpu:0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 3000

CMD ["node", "server.js"]
